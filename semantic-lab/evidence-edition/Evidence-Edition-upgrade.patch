+/* Semantic Twin Lab — Witness Workbench.
+   An instrument surface for comparing assertions, derivations, and source evidence. */
+:root {
+  color-scheme: dark;
+  --bg: #080e12;
+  --rail: #0b1519;
+  --panel: #101e23;
+  --panel-raised: #16292e;
+  --line: #2a4045;
+  --line-strong: #456166;
+  --ink: #ecf0e9;
+  --muted: #b0c0bf;
+  --dim: #8ca3a5;
+  --teal: #a2e2d2;
+  --gold: #edc181;
+  --red: #ffaaa0;
+  --blue: #afc8ee;
+  --sans: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
+  --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
+  --mono: "Cascadia Code", "SFMono-Regular", Consolas, "Liberation Mono", monospace;
+  font-family: var(--sans);
+  font-size: 14px;
+  font-synthesis: none;
+}
+* { box-sizing: border-box; }
+[hidden] { display: none !important; }
+html { scroll-behavior: smooth; scroll-padding-top: 100px; }
+body { margin: 0; color: var(--ink); background: var(--bg); line-height: 1.6; -webkit-font-smoothing: antialiased; }
+a { color: var(--teal); text-underline-offset: 4px; }
+a:hover { color: #d3f9ec; }
+button, input, select { font: inherit; color: inherit; }
+button, select, input { accent-color: var(--teal); }
+button, select { min-height: 40px; }
+button { cursor: pointer; }
+button:disabled { cursor: not-allowed; opacity: .45; }
+button, a, select, input { -webkit-tap-highlight-color: transparent; }
+:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
+::selection { color: #071713; background: #b4e9d8; }
+.skip { position: fixed; z-index: 100; left: 14px; top: -80px; padding: 12px 18px; border-radius: 4px; background: var(--teal); color: #0b251d; font-weight: 700; }
+.skip:focus { top: 12px; }
+.masthead { position: sticky; top: 0; z-index: 30; display: flex; justify-content: space-between; align-items: center; min-height: 86px; padding: 15px 30px; gap: 24px; border-bottom: 1px solid var(--line); background: #0a1216f5; backdrop-filter: blur(16px); }
+.brand { display: flex; align-items: center; gap: 14px; color: var(--ink); text-decoration: none; white-space: nowrap; }
+.brand svg { width: 36px; height: 40px; fill: none; stroke: var(--gold); stroke-width: 1.25; }
+.brand svg circle { fill: var(--bg); stroke: var(--teal); }
+.brand > span { display: block; font-size: 13px; letter-spacing: .17em; font-weight: 450; line-height: 1.35; }
+.brand b { color: var(--teal); font-weight: 650; }
+.brand small { display: block; margin-top: 6px; color: var(--dim); font: 8px/1.3 var(--mono); letter-spacing: .06em; }
+.masthead nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 24px; }
+.masthead nav > a { color: var(--muted); text-decoration: none; font-size: 11px; }
+.masthead nav > a:hover { color: var(--teal); }
+.outline { display: inline-flex; align-items: center; justify-content: center; gap: 12px; border: 1px solid var(--line-strong); border-radius: 4px; padding: 8px 14px; font-size: 11px; background: transparent; transition: border-color .2s, background .2s; }
+.outline:hover:not(:disabled) { border-color: var(--teal); background: #a2e2d209; }
+#notebook-count { display: inline-grid; place-items: center; min-width: 21px; min-height: 21px; border-radius: 3px; background: #213b3d; color: var(--teal); font: 10px var(--mono); }
+.shell { display: grid; grid-template-columns: 280px minmax(0, 1fr); min-height: calc(100dvh - 86px); }
+.rail { position: sticky; top: 86px; height: calc(100dvh - 86px); min-height: 540px; overflow-y: auto; display: flex; flex-direction: column; align-items: stretch; padding: 37px 27px 26px; background: linear-gradient(150deg, #101f22, var(--rail) 47%); border-right: 1px solid var(--line); scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
+.rail-kicker, .eyebrow { font: 9px/1.7 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--gold); }
+.rail h1 { margin: 24px 0 17px; font-size: 35px; line-height: 1.08; letter-spacing: -.045em; font-weight: 450; }
+.rail h1 em { display: inline-block; margin-top: 8px; color: var(--teal); font-family: var(--serif); font-weight: 400; letter-spacing: -.035em; }
+.intro { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.8; }
+.rail-rule { margin: 29px 0 24px; height: 1px; background: var(--line); }
+.field-label, .run-controls label { display: block; font-size: 11px; line-height: 1.4; color: var(--muted); }
+select { width: 100%; max-width: 100%; padding: 9px 30px 9px 11px; margin: 8px 0 0; border: 1px solid var(--line-strong); border-radius: 3px; background: #102025; font-size: 11px; outline-offset: 3px; text-overflow: ellipsis; }
+select:hover { border-color: #6c8d8f; }
+.fine { color: var(--dim); font-size: 11px; line-height: 1.75; overflow-wrap: anywhere; }
+.status-key { display: grid; gap: 10px; margin-top: 27px; padding-top: 23px; border-top: 1px solid var(--line); }
+.status-key > span { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 10px; line-height: 1.5; }
+.dot { width: 5px; height: 5px; flex: none; border-radius: 50%; background: var(--dim); }
+.dot.live { background: var(--teal); box-shadow: 0 0 10px #a2e2d230; }
+.dot.historic { background: var(--gold); }
+.dot.absent { background: transparent; border: 1px solid var(--dim); }
+.rail-bottom { margin-top: auto; padding-top: 44px; }
+.rail-bottom .eyebrow { font-size: 8px; color: var(--dim); }
+.rail-bottom p { font-family: var(--serif); color: #d3dcd2; font-size: 14px; line-height: 1.8; margin: 11px 0 14px; }
+.rail-bottom a { font-size: 10px; text-decoration: none; color: var(--gold); }
+#workspace { min-width: 0; padding: 23px 38px 0; max-width: 1620px; width: 100%; margin: 0 auto; background: radial-gradient(ellipse at 95% 10%, #16352f27, transparent 44%); }
+.workspace-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 24px; }
+.workspace-top > .eyebrow { color: var(--dim); font-size: 8px; line-height: 1.8; letter-spacing: .1em; }
+.session-state { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font: 9px/1.6 var(--mono); white-space: nowrap; }
+.session-state i { width: 4px; height: 4px; border-radius: 50%; background: var(--teal); }
+.tabs { display: flex; align-items: stretch; border-bottom: 1px solid var(--line); gap: 25px; }
+.tabs button { position: relative; background: none; border: 0; border-bottom: 2px solid transparent; padding: 10px 0 15px; margin-bottom: -1px; color: var(--dim); font: 9px/1.3 var(--mono); white-space: nowrap; }
+.tabs button span { margin-left: 8px; font: 12px/1.3 var(--sans); color: var(--muted); }
+.tabs button:hover span { color: var(--ink); }
+.tabs button[aria-selected="true"] { border-bottom-color: var(--teal); color: var(--teal); }
+.tabs button[aria-selected="true"] span { color: var(--ink); }
+.pane { padding: 34px 0 26px; }
+.section-heading { display: grid; grid-template-columns: minmax(0, 1fr) 245px; gap: 35px; align-items: end; margin-bottom: 29px; }
+.section-heading h2 { margin: 15px 0 17px; font-size: clamp(32px, 3.3vw, 54px); line-height: 1.04; font-weight: 450; letter-spacing: -.045em; }
