+    def test_entities_refused_and_invalid_xml_is_not_clean(self):
+        for src in (
+            b"<!DOCTYPE X3D [<!ENTITY attack 'expanded'>]><X3D/>",
+            b"<!DOCTYPE X3D [<!ENTITY attack SYSTEM 'file:///never-read'>]><X3D/>",
