+"""Bounded UTF-8 source witnesses and minimal X3D attribute edits.
+
+This is a lexical XML/identity inspector, not an XSD or X3D semantic validator.
+External DTDs are deliberately not loaded; supplied source bytes are never
+reserialised, and custom entity declarations are rejected.
+"""
+from __future__ import annotations
+
+import hashlib
+import hmac
+import re
+from dataclasses import dataclass
+from xml.parsers import expat
+
+MAX_SOURCE_BYTES = 8 * 1024 * 1024
+MAX_ELEMENTS = 100_000
+MAX_TAG_BYTES = 65_536
+MAX_DEPTH = 256
+_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_.-]*\Z")
+
+
+class SourceError(ValueError):
+    def __init__(self, code: str, message: str):
+        super().__init__(message)
+        self.code = code
+
+
+@dataclass
+class _Element:
+    name: str
+    attrs: dict
+    start: int
+    end: int
+    path: str
+    scope: int
+    line: int
+    column: int
+
+
+def _digest(source: bytes) -> str:
