          <ShaderPart DEF='ShellFS' type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
// shell.frag (hypersphere build; from the lookdev, shells now every 50 years from uShell0 to uTop): the glass hypersphere around the family, drawn on a proxy sphere a little larger than the analytic one (uRp > uR).
// Everything here is analytic or raymarched in pocket units; radius is time: r(year) = uR0 + (year - uY0) * uK.
// gl_FragDepth is written from the analytic entry point, so host geometry that passes between the glass and the proxy composites
// at the true surface, and the layer stays in front of the threads inside.
precision highp float; precision highp int;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix;
uniform float uCycle, uSeed, uExposure, uFell, uY0, uK, uR0, uR, uRp, uHaze, uGain, uShell0, uTop, uInside;
uniform int uQ, uBlend;
in vec3 vRo; in vec3 vRd;
out vec4 x3d_FragColor;
// common.glsl: hashes, value noise, fbm, tone map and the glow output, shared by every fragment shader (the generator pastes it in).
float h13(vec3 p) { p = fract(p * .1031); p += dot(p, p.zyx + 31.32); return fract((p.x + p.y) * p.z); }
float vnoise(vec3 x) {
  vec3 i = floor(x), f = fract(x); f = f * f * (3. - 2. * f);
  return mix(mix(mix(h13(i), h13(i + vec3(1., 0., 0.)), f.x), mix(h13(i + vec3(0., 1., 0.)), h13(i + vec3(1., 1., 0.)), f.x), f.y),
             mix(mix(h13(i + vec3(0., 0., 1.)), h13(i + vec3(1., 0., 1.)), f.x), mix(h13(i + vec3(0., 1., 1.)), h13(i + vec3(1., 1., 1.)), f.x), f.y), f.z);
}
// fbm normalised to 0..1 whatever the octave count, so a lower tier keeps the same brightness and only loses fine detail
float fbm(vec3 p, int oct) {
  float a = .5, s = 0., n = 0.;
  for (int i = 0; i < 7; i++) { if (i >= oct) break; s += a * vnoise(p); n += a; p = p * 2.03 + vec3(1.7, 9.2, 3.1); a *= .5; }
  return s / max(n, 1e-4);
}
float aces1(float x) { return clamp((x * (2.51 * x + .03)) / (x * (2.43 * x + .59) + .14), 0., 1.); }
vec3 aces(vec3 c) { return clamp((c * (2.51 * c + .03)) / (c * (2.43 * c + .59) + .14), 0., 1.); }   // Narkowicz ACES fit
vec3 encode(vec3 lin, float exposure) { return pow(aces(lin * exposure), vec3(.4545)); }             // tone map, then display gamma
// a soft black knee in linear light (build 2): the ACES toe plus gamma lifts tiny energies a lot (E 0.001 shows as 0.02), so a faint far field
// reads as fog; E * E / (E + k) leaves E >> k alone and pushes E << k toward black. k = 0 is the identity.
vec3 knee(vec3 E, float k) { return E * E / (E + vec3(k + 1e-9)); }
float dither(vec2 fc, float t) { return (h13(vec3(fc, floor(t * 60.))) - .5) / 255.; }                // one 8-bit step of noise: no banding
// The glow output. Standard X3D blends SRC_ALPHA, ONE_MINUS_SRC_ALPHA; writing (e / max(e), max(e)) turns that into
// out = e + dst * (1 - max(e)), a screen blend: light adds, nothing darkens, and the order of the layers barely matters.
// With X_ITE's BlendMode (ONE, ONE) the page sets uBlend = 1 and the layer is purely additive.
vec4 glowOut(vec3 e, int blend) {
  float a = max(max(e.r, e.g), e.b);
  if (a < .002) discard;
  if (blend == 1) return vec4(e, 1.);
  return vec4(e / a, a);
}
// sky.glsl: the host sky, computed per pixel from the view direction and a seed; nothing is fetched.
// d: unit direction; q: tier (0 fast, 1 balanced, 2 ultra); T: seconds in the 600 s loop; pxa: pixel footprint in radians (0 = no star LOD)
vec3 skyCol(vec3 d, int q, float T, float pxa, float seed) {
  vec3 sd = vec3(seed * 17.31, seed * 5.77, seed * 11.13);
  vec3 gN = normalize(vec3(.28, .92, -.27));                       // the galactic plane's pole
  float gl = dot(d, gN), band = exp(-gl * gl * 7.);
  int oct = 2 + 2 * q;                                             // nebula octaves: 2, 4, 6
  vec3 p = d * 2.2 + sd;
  float w = fbm(p * 1.4 + 4.1, max(oct - 2, 1));
  float n = fbm(p + 1.8 * vec3(w, -w, w * .5), oct);               // domain-warped nebula
  float m = fbm(p * 2.3 - 3.7, max(oct - 1, 1));
  float neb = smoothstep(q == 0 ? .57 : .5, .86, n);              // fewer octaves spread wider: raise the floor so tiers match
  vec3 col = vec3(.0035, .003, .009);
  col += neb * neb * mix(vec3(.36, .05, .50), vec3(.02, .30, .42), smoothstep(.35, .65, m)) * (.06 + .2 * band);
  col += vec3(.80, .20, .32) * pow(smoothstep(.6, .95, n * (.6 + m)), 3.) * .14 * band;
  col += vec3(.10, .09, .16) * band * .07;                         // unresolved starlight along the band
  if (q > 0) col *= 1. - .6 * band * smoothstep(.5, .8, fbm(p * 4.7 + 9.3, 3));   // dust lanes
  for (int L = 0; L < 3; L++) {                                    // hashed stars, one layer per tier
    if (L > q) break;
    float sc = L == 0 ? 60. : (L == 1 ? 150. : 320.);
    if (pxa * sc > .5) break;                                      // LOD by pixel footprint: no layer finer than ~2 px per cell
    vec3 g = d * sc + sd * float(L + 1), id = floor(g), f = fract(g) - .5;
    float hh = h13(id);
    if (hh < .955 - .03 * band) continue;
    vec3 jit = (vec3(h13(id + 7.), h13(id + 11.), h13(id + 13.)) - .5) * .5;
    float r = length(f - jit);
    float rad = max(.07, 1.3 * pxa * sc);                          // a star is never thinner than ~1.3 px ...
    float e = (.07 / rad) * (.07 / rad);                           // ... and keeps its energy when widened
    float mag = .5 + 4.5 * pow(h13(id + 3.), 4.);
    float tw = .82 + .18 * sin(T * 2.0943951 * (1. + floor(h13(id + 5.) * 3.)) + hh * 40.);   // twinkle periods 3, 1.5, 1 s
    vec3 tint = mix(vec3(1., .74, .52), vec3(.72, .84, 1.), h13(id + 17.));
    col += tint * smoothstep(rad, 0., r) * e * mag * tw * (L == 0 ? 1. : .7);
  }
  return col;
}
float depthOf(vec3 p) { vec4 c = x3d_ProjectionMatrix * (x3d_ModelViewMatrix * vec4(p, 1.)); return clamp(c.z / c.w * .5 + .5, 0., 1.); }
float erf1(float x) { float a = abs(x), t = 1. / (1. + .47047 * a); return sign(x) * (1. - t * (.3480242 + t * (-.0958798 + t * .7478556)) * exp(-a * a)); }
// integral of exp(-r^2/s2) along the ray between ta and tb (measured from the closest approach; d2 = squared closest distance)
float gaussInt(float d2, float s2, float ta, float tb) { float s = sqrt(s2); return .8862269 * s * exp(-d2 / s2) * (erf1(tb / s) - erf1(ta / s)); }
// integral of 1/(r^2 + e2) along the ray: a point light seen through a medium, exact
float pointInt(float d2, float e2, float ta, float tb) { float k = sqrt(d2 + e2); return (atan(tb / k) - atan(ta / k)) / k; }
vec3 timeTint(float r) { return mix(vec3(1., .60, .30), vec3(.40, .55, 1.), smoothstep(.05, 1.05, r)); }   // warm past, cool present
void main() {
  vec3 ro = vRo, rd = normalize(vRd);
  float T = uCycle * 600.;
  float b = dot(ro, rd), rr = dot(ro, ro);
  float d2 = max(rr - b * b, 0.), d = sqrt(d2), tc = -b;
  bool camInProxy = rr < uRp * uRp;
  if (!gl_FrontFacing && !camInProxy) discard;            // with solid=false seen from outside, keep one layer: no double glow
  vec3 E = vec3(0.);
  float depth = gl_FragCoord.z;
  float rFell = uR0 + (uFell - uY0) * uK;
  float rWave = fract(T / 12.) * 1.25 - .1;               // the energy front: leaves the seed every 12 s and runs out past the glass
  float h = uR * uR - d2;
  float in01 = 1. - smoothstep(uR * .9, uR, sqrt(rr));    // 1 with the camera inside the glass (build 2: the plunge's landing must keep its black)
  float face = mix(1., .15, in01);                         // inside, the shells' face-on whisper is cut; their limbs stay crisp
  if (h <= 0.) {                                           // the ray misses the glass: atmospheric halo only
    if (tc <= 0.) discard;
    float x = clamp((d - uR) / (uRp - uR), 0., 1.);
    E = vec3(.40, .56, 1.) * .22 * exp(-x * 9.) * (1. - x);
    depth = depthOf(ro + rd * tc);
  } else {
    float sq = sqrt(h), t0 = max(tc - sq, 0.), t1 = tc + sq;
    if (t1 <= 0.) discard;
    if (rr > uR * uR) {                                    // camera outside the glass: fresnel limb, sky reflection, key-light glint
      vec3 p0 = ro + rd * t0, n = p0 / uR;
      float ci = clamp(-dot(n, rd), 0., 1.);
      float F = .04 + .96 * pow(1. - ci, 5.);              // Schlick, glass F0 = 0.04
      E += vec3(.40, .56, 1.) * (pow(1. - ci, 6.) * 1.1 + pow(1. - ci, 2.) * .05);   // a thin bright rim over a faint body
      vec3 rf = reflect(rd, n);
      if (uQ > 0) E += skyCol(rf, 0, T, 0., uSeed) * F * 2.5;
      float kl = max(dot(rf, normalize(vec3(.45, .62, .64))), 0.);          // the Key light's reflection: a crisp glint over a soft sheen
      E += vec3(1., .95, .9) * (pow(kl, 600.) * 14. + pow(kl, 24.) * .35) * F;
      depth = depthOf(p0);
    }                                                      // inside: keep the proxy's far wall, so the threads stay crisp in front
    for (int k = 0; k < 16; k++) {                         // time shells every 50 years (uShell0, uShell0 + 50, ... up to uTop): thin emitting spheres
      float yk = uShell0 + 50. * float(k);
      if (yk > uTop + .5) break;
      float rk = uR0 + (yk - uY0) * uK, hk = rk * rk - d2;
      if (hk <= 0.) continue;
      float sk = sqrt(hk), ck = sk / rk;                   // |cos| between the ray and the shell normal
      float woven = smoothstep(uFell + 3., uFell - 3., yk);
      float pulse = 1. + 2.2 * exp(-pow((rk - rWave) / .045, 2.));
      float line = .0012 * face / max(ck, .05) + .045 * exp(-ck * ck / .012);   // a whisper face-on (path ~ 1/cos), a crisp line at the limb
      vec3 c = timeTint(rk) * line * pulse * mix(.12, 1., woven);
      if (tc - sk > t0) E += c;                            // near crossing
      if (tc + sk > t0) E += c * .5;                       // far crossing, dimmer
    }
    float hf = rFell * rFell - d2;                         // the fell: the shell being woven now glows hot
    if (hf > 0. && rFell < uR) {
      float sf = sqrt(hf), cf = sf / rFell;
      vec3 c = vec3(1., .80, .52) * (.002 * face / max(cf, .05) + .08 * exp(-cf * cf / .012));
      if (tc - sf > t0) E += c;
      if (tc + sf > t0) E += c * .45;
    }
    float ta = t0 - tc, tb = t1 - tc;
    // build 2 (critique fix 1): with the camera inside the glass every ray crosses the whole haze, and the body fogged the plunge's landing.
    // uInside scales the haze when the camera is inside, decided here from the camera's own radius, so it holds in any host with no page.
    float kin = mix(uInside, 1., smoothstep(uR * .9, uR, sqrt(rr)));
    E += vec3(.42, .26, .78) * gaussInt(d2, .36, ta, tb) * .02 * uHaze * kin;     // haze body: analytic, every tier
    if (uQ > 0) {                                          // haze flow: radial streaks and outward ripples, glow accumulated along the ray
      int N = uQ == 1 ? 12 : 28;
      float dt = (t1 - t0) / float(N), j = h13(vec3(gl_FragCoord.xy, floor(T * 30.)));
      vec3 acc = vec3(0.);
      for (int i = 0; i < 28; i++) {
        if (i >= N) break;
        float t = t0 + (float(i) + j) * dt;
        vec3 p = ro + rd * t; float r = length(p);
        float st = fbm(p / max(r, 1e-4) * 3.3 + uSeed * 3.1, uQ == 1 ? 3 : 5);   // noise of direction only: streaks that point outward
        float rip = .6 + .4 * sin(6.2831853 * (r / .15 - T / 4.));              // ripples: 0.15 units every 4 s, outward
        float fr = exp(-pow((r - rWave) / .06, 2.));
        float woven = smoothstep(rFell + .04, rFell - .04, r);
        float dens = exp(-r * r / .5) * smoothstep(.5, .9, st) * rip * (.25 + .75 * woven) + fr * .5 * smoothstep(.55, .9, st);
        acc += dens * mix(vec3(.55, .32, .95), timeTint(r), .55);
      }
      E += acc * dt * .08 * uHaze * kin;
    }
    // the founders' seed has its own glow layer (seed.frag), so it blooms over the seed from inside the glass as well
  }
  gl_FragDepth = depth;
  x3d_FragColor = glowOut(encode(knee(E, .005 * in01) * uGain, uExposure) + dither(gl_FragCoord.xy, T), uBlend);
}
]]></ShaderPart>
        </ComposedShader>
      </Appearance>
      <IndexedTriangleSet DEF='ShellProxy' solid='false' index='0 162 164 42 163 162 44 164 163 162 163 164 12 165 167 43 166 165 42 167 166 165 166 167 14 168 170 44 169 168 43 170 169 168 169 170 42 166 163 43 169 166 44 163 169 166 169 163 11 171 173 45 172 171 47 173 172 171 172 173 13 174 176 46 175 174 45 176 175 174 175 176 12 177 179 47 178 177 46 179 178 177 178 179 45 175 172 46 178 175 47 172 178 175 178 172 5 180 182 48 181 180 50 182 181 180 181 182 14 183 185 49 184 183 48 185 184 183 184 185 13 186 188 50 187 186 49 188 187 186 187 188 48 184 181 49 187 184 50 181 187 184 187 181 12 179 165 46 189 179 43 165 189 179 189 165 13 188 174 49 190 188 46 174 190 188 190 174 14 170 183 43 191 170 49 183 191 170 191 183 46 190 189 49 191 190 43 189 191 190 191 189 0 164 193 44 192 164 52 193 192 164 192 193 14 194 168 51 195 194 44 168 195 194 195 168 16 196 198 52 197 196 51 198 197 196 197 198 44 195 192 51 197 195 52 192 197 195 197 192 5 199 180 53 200 199 48 180 200 199 200 180 15 201 203 54 202 201 53 203 202 201 202 203 14 185 205 48 204 185 54 205 204 185 204 205 53 202 200 54 204 202 48 200 204 202 204 200 1 206 208 55 207 206 57 208 207 206 207 208 16 209 211 56 210 209 55 211 210 209 210 211 15 212 214 57 213 212 56 214 213 212 213 214 55 210 207 56 213 210 57 207 213 210 213 207 14 205 194 54 215 205 51 194 215 205 215 194 15 214 201 56 216 214 54 201 216 214 216 201 16 198 209 51 217 198 56 209 217 198 217 209 54 216 215 56 217 216 51 215 217 216 217 215 0 193 219 52 218 193 59 219 218 193 218 219 16 220 196 58 221 220 52 196 221 220 221 196 18 222 224 59 223 222 58 224 223 222 223 224 52 221 218 58 223 221 59 218 223 221 223 218 1 225 206 60 226 225 55 206 226 225 226 206 17 227 229 61 228 227 60 229 228 227 228 229 16 211 231 55 230 211 61 231 230 211 230 231 60 228 226 61 230 228 55 226 230 228 230 226 7 232 234 62 233 232 64 234 233 232 233 234 18 235 237 63 236 235 62 237 236 235 236 237 17 238 240 64 239 238 63 240 239 238 239 240 62 236 23