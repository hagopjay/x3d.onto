    <!-- THE SUBJECT BEAD: on a close shot the page moves BeadXf to the stop's event (a point on the subject's life, or the middle of a marriage
         arc, where uRing draws a ring) and turns BeadSwitch on. The same point-glow shader as the seed, smaller, on a 2 s breath. -->
    <Transform DEF='BeadXf'>
      <Switch DEF='BeadSwitch' whichChoice='-1'>
        <Shape DEF='Bead'>
          <Appearance DEF='BeadApp' alphaMode='BLEND'>
            <ComposedShader DEF='BeadGlow' language='GLSL'>
              <field name='uCycle' type='SFFloat' accessType='inputOutput' value='0.25'/>
              <field name='uExposure' type='SFFloat' accessType='inputOutput' value='1'/>
              <field name='uRg' type='SFFloat' accessType='inputOutput' value='0.02'/>
              <field name='uGain' type='SFFloat' accessType='inputOutput' value='1'/>
              <field name='uE2' type='SFFloat' accessType='inputOutput' value='0.002'/>
              <field name='uS2' type='SFFloat' accessType='inputOutput' value='0.005'/>
              <field name='uHalo' type='SFFloat' accessType='inputOutput' value='0.0011'/>
              <field name='uCore' type='SFFloat' accessType='inputOutput' value='20'/>
              <field name='uPeriod' type='SFFloat' accessType='inputOutput' value='2'/>
              <field name='uRing' type='SFFloat' accessType='inputOutput' value='0'/>
              <field name='uKnee' type='SFFloat' accessType='inputOutput' value='0.002'/>
              <field name='uZ' type='SFFloat' accessType='inputOutput' value='-0.12'/>
              <field name='uHaloTint' type='SFVec3f' accessType='inputOutput' value='1 0.72 0.38'/>
              <field name='uCoreTint' type='SFVec3f' accessType='inputOutput' value='1 0.94 0.82'/>
              <field name='uBlend' type='SFInt32' accessType='inputOutput' value='0'/>
              <ShaderPart USE='RayVS'/>
              <ShaderPart USE='SeedFS'/>
            </ComposedShader>
          </Appearance>
