          <ShaderPart DEF='RayVS' type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
// ray.vert: the proxy-geometry vertex shader (the pocket pages' pattern). The ray is set up in the shape's own local space with
// inverse(x3d_ModelViewMatrix), so the fragment shader works in pocket units whatever Transform scale nests it in a host.
precision highp float;
uniform mat4 x3d_ProjectionMatrix, x3d_ModelViewMatrix;
in vec4 x3d_Vertex;
out vec3 vRo; out vec3 vRd;
void main() {
  vec4 vp = x3d_ModelViewMatrix * x3d_Vertex;
  mat4 inv = inverse(x3d_ModelViewMatrix);          // eye space -> local space
  vRo = (inv * vec4(0., 0., 0., 1.)).xyz;           // the camera in local units
  vRd = (inv * vec4(vp.xyz, 1.)).xyz - vRo;
  gl_Position = x3d_ProjectionMatrix * vp;
}
]]></ShaderPart>
          <ShaderPart DEF='SkyFS' type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
// sky.frag: the host sky on an inverted proxy sphere. Opaque; direction only, so it reads as infinitely far.
precision highp float; precision highp int;
uniform float uCycle, uSeed, uExposure;
uniform int uQ;
in vec3 vRo; in vec3 vRd;
out vec4 x3d_FragColor;
// common.glsl: hashes, value noise, fbm, tone map and the glow output, shared by every fragment shader (the generator pastes it in).
float h13(vec3 p) { p = fract(p * .1031); p += dot(p, p.zyx + 31.32); return fract((p.x + p.y) * p.z); }
float vnoise(vec3 x) {
  vec3 i = floor(x), f = fract(x); f = f * f * (3. - 2. * f);
  return mix(mix(mix(h13(i), h13(i + vec3(1., 0., 0.)), f.x), mix(h13(i + vec3(0., 1., 0.)), h13(i + vec3(1., 1., 0.)), f.x), f.y),
             mix(mix(h13(i + vec3(0., 0., 1.)), h13(i + vec3(1., 0., 1.)), f.x), mix(h13(i + vec3(0., 1., 1.)), h13(i + vec3(1., 1., 1.)), f.x), f.y), f.z);
}
// fbm normalised to 0..1 whatever the octave count, so a lower tier keeps the same brightness and only loses fine detail
float fbm(vec3 p, int oct) {
  float a = .5, s = 0., n = 0.;
  for (int i = 0; i < 7; i++) { if (i >= oct) break; s += a * vnoise(p); n += a; p = p * 2.03 + vec3(1.7, 9.2, 3.1); a *= .5; }
  return s / max(n, 1e-4);
}
float aces1(float x) { return clamp((x * (2.51 * x + .03)) / (x * (2.43 * x + .59) + .14), 0., 1.); }
vec3 aces(vec3 c) { return clamp((c * (2.51 * c + .03)) / (c * (2.43 * c + .59) + .14), 0., 1.); }   // Narkowicz ACES fit
vec3 encode(vec3 lin, float exposure) { return pow(aces(lin * exposure), vec3(.4545)); }             // tone map, then display gamma
// a soft black knee in linear light (build 2): the ACES toe plus gamma lifts tiny energies a lot (E 0.001 shows as 0.02), so a faint far field
// reads as fog; E * E / (E + k) leaves E >> k alone and pushes E << k toward black. k = 0 is the identity.
vec3 knee(vec3 E, float k) { return E * E / (E + vec3(k + 1e-9)); }
float dither(vec2 fc, float t) { return (h13(vec3(fc, floor(t * 60.))) - .5) / 255.; }                // one 8-bit step of noise: no banding
// The glow output. Standard X3D blends SRC_ALPHA, ONE_MINUS_SRC_ALPHA; writing (e / max(e), max(e)) turns that into
// out = e + dst * (1 - max(e)), a screen blend: light adds, nothing darkens, and the order of the layers barely matters.
// With X_ITE's BlendMode (ONE, ONE) the page sets uBlend = 1 and the layer is purely additive.
vec4 glowOut(vec3 e, int blend) {
  float a = max(max(e.r, e.g), e.b);
  if (a < .002) discard;
  if (blend == 1) return vec4(e, 1.);
  return vec4(e / a, a);
}
// sky.glsl: the host sky, computed per pixel from the view direction and a seed; nothing is fetched.
// d: unit direction; q: tier (0 fast, 1 balanced, 2 ultra); T: seconds in the 600 s loop; pxa: pixel footprint in radians (0 = no star LOD)
vec3 skyCol(vec3 d, int q, float T, float pxa, float seed) {
  vec3 sd = vec3(seed * 17.31, seed * 5.77, seed * 11.13);
  vec3 gN = normalize(vec3(.28, .92, -.27));                       // the galactic plane's pole
  float gl = dot(d, gN), band = exp(-gl * gl * 7.);
  int oct = 2 + 2 * q;                                             // nebula octaves: 2, 4, 6
  vec3 p = d * 2.2 + sd;
  float w = fbm(p * 1.4 + 4.1, max(oct - 2, 1));
  float n = fbm(p + 1.8 * vec3(w, -w, w * .5), oct);               // domain-warped nebula
  float m = fbm(p * 2.3 - 3.7, max(oct - 1, 1));
  float neb = smoothstep(q == 0 ? .57 : .5, .86, n);              // fewer octaves spread wider: raise the floor so tiers match
  vec3 col = vec3(.0035, .003, .009);
  col += neb * neb * mix(vec3(.36, .05, .50), vec3(.02, .30, .42), smoothstep(.35, .65, m)) * (.06 + .2 * band);
  col += vec3(.80, .20, .32) * pow(smoothstep(.6, .95, n * (.6 + m)), 3.) * .14 * band;
  col += vec3(.10, .09, .16) * band * .07;                         // unresolved starlight along the band
  if (q > 0) col *= 1. - .6 * band * smoothstep(.5, .8, fbm(p * 4.7 + 9.3, 3));   // dust lanes
  for (int L = 0; L < 3; L++) {                                    // hashed stars, one layer per tier
    if (L > q) break;
    float sc = L == 0 ? 60. : (L == 1 ? 150. : 320.);
    if (pxa * sc > .5) break;                                      // LOD by pixel footprint: no layer finer than ~2 px per cell
    vec3 g = d * sc + sd * float(L + 1), id = floor(g), f = fract(g) - .5;
    float hh = h13(id);
    if (hh < .955 - .03 * band) continue;
    vec3 jit = (vec3(h13(id + 7.), h13(id + 11.), h13(id + 13.)) - .5) * .5;
    float r = length(f - jit);
    float rad = max(.07, 1.3 * pxa * sc);                          // a star is never thinner than ~1.3 px ...
    float e = (.07 / rad) * (.07 / rad);                           // ... and keeps its energy when widened
    float mag = .5 + 4.5 * pow(h13(id + 3.), 4.);
    float tw = .82 + .18 * sin(T * 2.0943951 * (1. + floor(h13(id + 5.) * 3.)) + hh * 40.);   // twinkle periods 3, 1.5, 1 s
    vec3 tint = mix(vec3(1., .74, .52), vec3(.72, .84, 1.), h13(id + 17.));
    col += tint * smoothstep(rad, 0., r) * e * mag * tw * (L == 0 ? 1. : .7);
  }
  return col;
}
void main() {
  vec3 d = normalize(vRd);
  float T = uCycle * 600.;
  float pxa = length(fwidth(d));
  vec3 c = skyCol(d, uQ, T, pxa, uSeed);
  x3d_FragColor = vec4(encode(c, uExposure) + dither(gl_FragCoord.xy, T), 1.);
}
]]></ShaderPart>
        </ComposedShader>
