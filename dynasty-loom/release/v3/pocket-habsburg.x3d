    <!-- CLOCKS: standard X3D drives the shaders, so the pocket animates by itself when Inlined in any host. Every period divides 600 s. -->
    <TimeSensor DEF='Clock' cycleInterval='600' loop='true'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='ShellShader' toField='uCycle'/>
    <ROUTE fromNode='Clock' fromField='fraction_changed' toNode='SeedGlow' toField='uCycle'/>
