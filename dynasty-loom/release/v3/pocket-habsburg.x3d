        <ComposedShader DEF='SeedGlow' language='GLSL'>
          <field name='uCycle' type='SFFloat' accessType='inputOutput' value='0.25'/>
          <field name='uExposure' type='SFFloat' accessType='inputOutput' value='1.1'/>
